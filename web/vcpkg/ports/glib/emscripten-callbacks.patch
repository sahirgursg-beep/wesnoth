diff --git a/glib/glist.c b/glib/glist.c
index 8ba2f84..1e42cc7 100644
--- a/glib/glist.c
+++ b/glib/glist.c
@@ -159,7 +159,10 @@ void
 g_list_free_full (GList          *list,
                   GDestroyNotify  free_func)
 {
-  g_list_foreach (list, (GFunc) free_func, NULL);
+  /* wasm: call free_func with exactly one argument (no GFunc cast) */
+  GList *l;
+  for (l = list; l != NULL; l = l->next)
+    free_func (l->data);
   g_list_free (list);
 }
 
@@ -1081,12 +1084,24 @@ g_list_insert_sorted_real (GList    *list,
  *
  * Returns: the (possibly changed) start of the #GList
  */
+
+/* wasm: GCompareFunc takes two arguments; the *_real helpers call their
+ * function as a three-argument GCompareDataFunc. Go through an adapter
+ * that carries the real compare function as user_data. */
+static gint
+g_list_compare_func_adapter (gconstpointer a,
+                         gconstpointer b,
+                         gpointer      compare_func)
+{
+  return ((GCompareFunc) compare_func) (a, b);
+}
+
 GList *
 g_list_insert_sorted (GList        *list,
                       gpointer      data,
                       GCompareFunc  func)
 {
-  return g_list_insert_sorted_real (list, data, (GFunc) func, NULL);
+  return g_list_insert_sorted_real (list, data, (GFunc) g_list_compare_func_adapter, (gpointer) func);
 }
 
 /**
@@ -1217,7 +1232,7 @@ GList *
 g_list_sort (GList        *list,
              GCompareFunc  compare_func)
 {
-  return g_list_sort_real (list, (GFunc) compare_func, NULL);
+  return g_list_sort_real (list, (GFunc) g_list_compare_func_adapter, (gpointer) compare_func);
 }
 
